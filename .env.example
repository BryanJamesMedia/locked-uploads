# Postgres (Neon)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Blob (private store)
BLOB_READ_WRITE_TOKEN=

# Local filesystem storage fallback when BLOB_READ_WRITE_TOKEN is unset
STORAGE_DRIVER=local

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend
RESEND_API_KEY=
EMAIL_FROM="Locked Uploads <onboarding@resend.dev>"

# Dev only: completes checkout without Stripe keys (never set in production)
ALLOW_TEST_CHECKOUT=
